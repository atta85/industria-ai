# Copy these into Streamlit Cloud: your app > Settings > Secrets.
# Never commit a real secrets.toml to GitHub.

# Required
GROQ_API_KEY = "gsk_..."

# Optional: web evidence and academic references
SERPER_API_KEY = "..."
OPENALEX_API_KEY = "..."

# Optional: history and feedback storage (Supabase)
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-supabase-secret-or-service-role-key"

# Optional: Sign in with Google (see SETUP_GUIDE.md)
[auth]
redirect_uri = "https://your-app-name.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string-of-at-least-32-characters"
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
